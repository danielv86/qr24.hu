generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  // CJS: a generált kliens így nem olvassa modul szinten az import.meta.url-t,
  // amit a Nitro a szerver-chunkban helyőrzőre cserél (Windows-indítási hiba).
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  email          String         @unique @db.VarChar(190)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  role           String         @default("admin") @db.VarChar(20)
  failedAttempts Int            @default(0) @map("failed_attempts") @db.UnsignedInt
  lockedUntil    DateTime?      @map("locked_until")
  lastLoginAt    DateTime?      @map("last_login_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  sessions       AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  adminId   Int       @map("admin_id") @db.UnsignedInt
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_sessions")
}

model User {
  id                         BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  email                      String          @unique @db.VarChar(190)
  name                       String?         @db.VarChar(120)
  passwordHash               String?         @map("password_hash") @db.VarChar(255)
  plan                       String          @default("free") @db.VarChar(20)
  emailVerified              Boolean         @default(false) @map("email_verified") @db.TinyInt
  /**
   * A regisztrációkor kiküldött 6 jegyű kód lenyomata (HMAC).
   */
  emailVerificationCodeHash  String?         @map("email_verification_code_hash") @db.Char(64)
  emailVerificationExpiresAt DateTime?       @map("email_verification_expires_at")
  emailVerificationSentAt    DateTime?       @map("email_verification_sent_at")
  emailVerificationAttempts  Int             @default(0) @map("email_verification_attempts") @db.UnsignedInt
  lastLoginAt                DateTime?       @map("last_login_at")
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")
  sessions                   UserSession[]
  oauthAccounts              OAuthAccount[]
  qrCodes                    DynamicQrCode[]
  auditLogs                  AuditLog[]
  customDomains              CustomDomain[]
  apiKeys                    ApiKey[]
  subscription               Subscription?

  @@map("users")
}

/**
 * Fiókhoz tartozó előfizetés. Egy felhasználónak legfeljebb egy aktuális
 * előfizetése van; a lemondás után a sor megmarad (státusz: expired), így a
 * próbaidőszak kihasználtsága is nyomon követhető.
 */
model Subscription {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId             BigInt    @unique @map("user_id") @db.UnsignedBigInt
  plan               String    @db.VarChar(20)
  interval           String    @db.VarChar(10)
  status             String    @db.VarChar(20)
  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  /**
   * A vásárláskor rögzített időszakár forintban. Az admin árváltozása ezt nem
   * írja felül, így a kifizetett időszak ára végig változatlan marad.
   */
  price              Int       @default(0) @db.UnsignedInt
  /** Az ár pénzneme (jelenleg mindig HUF). */
  currency           String    @default("HUF") @db.VarChar(3)
  canceledAt         DateTime? @map("canceled_at")
  endedAt            DateTime? @map("ended_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UserSession {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OAuthAccount {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  provider          String   @db.VarChar(20)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  email             String?  @db.VarChar(190)
  userId            BigInt   @map("user_id") @db.UnsignedBigInt
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model DynamicQrCode {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId      String          @unique @map("public_id") @db.VarChar(16)
  targetUrl     String          @map("target_url") @db.VarChar(2048)
  title         String?         @db.VarChar(120)
  description   String?         @db.VarChar(500)
  category      String?         @db.VarChar(60)
  campaign      String?         @db.VarChar(60)
  status        String          @default("active") @db.VarChar(16)
  expiresAt     DateTime?       @map("expires_at")
  /**
   * A QR-kód megjelenítési beállításai JSON-ban, hogy a kép újra előállítható legyen.
   */
  style         String?         @db.Text
  ownerId       BigInt?         @map("owner_id") @db.UnsignedBigInt
  ownerRef      String?         @map("owner_ref") @db.VarChar(64)
  editTokenHash String          @map("edit_token_hash") @db.Char(64)
  isActive      Boolean         @default(true) @map("is_active") @db.TinyInt
  scans         BigInt          @default(0) @db.UnsignedBigInt
  lastScanAt    DateTime?       @map("last_scan_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  owner         User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dailyScans    DynamicQrScan[]
  scanEvents    ScanEvent[]
  auditLogs     AuditLog[]

  @@index([isActive, createdAt])
  @@index([status, createdAt])
  @@index([ownerRef])
  @@index([ownerId, createdAt])
  @@index([expiresAt])
  @@map("dynamic_qr_codes")
}

model DynamicQrScan {
  qrId  BigInt        @map("qr_id") @db.UnsignedBigInt
  day   DateTime      @db.Date
  scans Int           @default(0) @db.UnsignedInt
  qr    DynamicQrCode @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@id([qrId, day])
  @@index([day])
  @@map("dynamic_qr_scans")
}

model ScanEvent {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  qrId        BigInt        @map("qr_id") @db.UnsignedBigInt
  createdAt   DateTime      @default(now()) @map("created_at")
  device      String        @default("unknown") @db.VarChar(16)
  browser     String        @default("unknown") @db.VarChar(24)
  country     String?       @db.Char(2)
  refererHost String?       @map("referer_host") @db.VarChar(190)
  isBot       Boolean       @default(false) @map("is_bot") @db.TinyInt
  qr          DynamicQrCode @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId, createdAt])
  @@index([createdAt])
  @@map("scan_events")
}

model AuditLog {
  id        BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  action    String         @db.VarChar(40)
  userId    BigInt?        @map("user_id") @db.UnsignedBigInt
  qrId      BigInt?        @map("qr_id") @db.UnsignedBigInt
  details   String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  qr        DynamicQrCode? @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model CustomDomain {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId            BigInt    @map("user_id") @db.UnsignedBigInt
  host              String    @unique @db.VarChar(190)
  /**
   * A DNS TXT rekord értéke, amivel a tulajdonjog igazolható.
   */
  verificationToken String    @map("verification_token") @db.VarChar(64)
  verifiedAt        DateTime? @map("verified_at")
  lastCheckedAt     DateTime? @map("last_checked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("custom_domains")
}

model ApiKey {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt    @map("user_id") @db.UnsignedBigInt
  name       String    @db.VarChar(80)
  /**
   * A kulcs első pár karaktere, hogy a listában felismerhető legyen.
   */
  prefix     String    @db.VarChar(16)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("api_keys")
}

model Setting {
  key       String   @id @map("setting_key") @db.VarChar(64)
  value     String   @map("setting_value") @db.LongText
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model SeoOverride {
  path        String   @id @db.VarChar(120)
  title       String   @default("") @db.VarChar(70)
  description String   @default("") @db.VarChar(180)
  noindex     Boolean  @default(false) @db.TinyInt
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("seo_overrides")
}

model BlogPost {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  slug           String    @unique @db.VarChar(160)
  title          String    @db.VarChar(160)
  excerpt        String    @default("") @db.VarChar(320)
  /** Tisztított HTML a TipTap szerkesztőből. */
  content        String    @db.LongText
  coverImage     String?   @map("cover_image") @db.VarChar(512)
  category       String    @default("") @db.VarChar(60)
  /** Vesszővel elválasztott címkék. */
  tags           String    @default("") @db.VarChar(240)
  status         String    @default("draft") @db.VarChar(16)
  publishedAt    DateTime? @map("published_at")
  readingMinutes Int       @default(1) @map("reading_minutes") @db.UnsignedInt
  views          Int       @default(0) @db.UnsignedInt
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model BlogMedia {
  /** Rövid, véletlen azonosító a nyilvános URL-hez. */
  id        String   @id @db.VarChar(40)
  fileName  String   @map("file_name") @db.VarChar(160)
  mimeType  String   @map("mime_type") @db.VarChar(80)
  size      Int      @db.UnsignedInt
  /** A fájl neve a lemezen (storage/blog-media), nem az eredeti feltöltött név. */
  storageName String @map("storage_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("blog_media")
}

model RateLimit {
  keyHash     String   @id @map("key_hash") @db.Char(64)
  windowStart BigInt   @map("window_start") @db.UnsignedBigInt
  hits        Int      @default(0) @db.UnsignedInt
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([windowStart])
  @@map("rate_limits")
}

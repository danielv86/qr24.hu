# ── Nyilvános beállítások ────────────────────────────────────────────────
# Éles környezetben a saját domain (https://…), különben a kanonikus URL-ek
# és a sitemap localhostra mutatnak.
NUXT_PUBLIC_SITE_URL=https://qr24.hu
NUXT_PUBLIC_BRAND_NAME="QR24.hu"
NUXT_PUBLIC_DYNAMIC_QR_ENABLED=true

# Google AdSense – a hirdetések csak a marketing-hozzájárulás után töltődnek be.
# Az admin felületen is megadható, ott az adatbázis értéke él.
NUXT_PUBLIC_ADSENSE_CLIENT=
NUXT_PUBLIC_ADSENSE_SLOT_TOP=
NUXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NUXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NUXT_PUBLIC_ADSENSE_SLOT_GUIDE=
NUXT_PUBLIC_ADSENSE_SLOT_MOBILE=

# ── Titkok (soha ne kerüljenek verziókezelésbe) ──────────────────────────
# openssl rand -base64 48
NUXT_SESSION_SECRET=
NUXT_HASH_SECRET=

# ── MySQL / Prisma ───────────────────────────────────────────────────────
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_NAME=qr24
NUXT_DB_USER=qr24
NUXT_DB_PASSWORD=

# Ha reverse proxy mögött fut, a valós kliens IP-hez
NUXT_TRUST_PROXY=false

# ── Admin fiók a db:setup szkripthez ─────────────────────────────────────
ADMIN_EMAIL=admin@qr24.hu
ADMIN_PASSWORD=

# ── Külső bejelentkezés (opcionális) ─────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
#   Átirányítás: https://qr24.hu/api/auth/oauth/google/callback
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Apple: https://developer.apple.com/account/resources/identifiers
#   Átirányítás: https://qr24.hu/api/auth/oauth/apple/callback
NUXT_OAUTH_APPLE_CLIENT_ID=
NUXT_OAUTH_APPLE_TEAM_ID=
NUXT_OAUTH_APPLE_KEY_ID=
# A .p8 kulcs egy sorban, \n karakterekkel
NUXT_OAUTH_APPLE_PRIVATE_KEY=
